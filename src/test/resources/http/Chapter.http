### ==========================================
### READ CHAPTERS
### ==========================================

GET {{url}}/chapters/random
Authorization: Bearer {{token}}
Accept: application/json

###

GET {{url}}/chapters/1
Authorization: Bearer {{token}}
Accept: application/json

###

GET {{url}}/chapters
Authorization: Bearer {{token}}
Accept: application/json

###

### ==========================================
### UPDATE CHAPTER
### ==========================================

PUT {{url}}/chapters/1
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{
  "title": "Updated Title",
  "subtitle": "Updated subtitle",
  "content": "Updated content",
  "visibility": "PUBLIC"
}

###

### ==========================================
### DELETE CHAPTER
### ==========================================

DELETE {{url}}/chapters/2
Authorization: Bearer {{token}}
Accept: application/json