### ==========================================
### CREATE CHAPTERS
### ==========================================

POST {{url}}/chapters
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{
  "title": "The Beginning of the Journey",
  "subtitle": "Setting out into the unknown",
  "content": "This is the main body text of the chapter detailing the adventures and milestones.",
  "startDate": "2026-09-28",
  "endDate": "2026-10-05",
  "visibility": "PRIVATE"
}

###

POST {{url}}/chapters
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{
  "title": "Years in China",
  "subtitle": "Setting out into the unknown",
  "content": "This is the main body text of the chapter detailing the adventures and milestones.",
  "startDate": "2026-09-28",
  "endDate": "2026-10-05",
  "visibility": "PRIVATE"
}

