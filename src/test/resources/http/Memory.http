### Create First Memory
POST localhost:7070/api/memories
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJleHAiOjE3OTA4NjI0MTAsInN1YiI6ImFuZHJlYXNAbGl2ZS5kayIsImlhdCI6MTc5MDc3NjAxMH0.jhl0hCyMxce3mHKBrMxSFO_B6t4wk75VEG2I8qjy7LU
Accept: application/json
Content-Type: application/json

{
  "title": "A Summer in Kyoto",
  "subtitle": "Temples, bamboo forests, and endless rain",
  "content": "Walking through the quiet paths of Arashiyama at dawn felt like stepping into another world. The morning mist clung to the bamboo stalks as the city slowly woke up.",
  "date": "2026-07-14",
  "visibility": "PRIVATE"
}

