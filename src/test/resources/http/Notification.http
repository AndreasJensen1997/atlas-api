### ==========================================
### CREATE NOTIFICATIONS
### ==========================================

POST {{url}}/notifications
Authorization: {{JWT}}
Accept: application/json
Content-Type: application/json

{
  "title": "You were mentioned in a memory",
  "notificationType": "MENTION",
  "targetId": 1,
  "targetType": "MEMORY",
  "read": false,
  "createdAt": "2026-10-06T12:00:00"
}

